{
  "name": "DS635 fixed point",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "pip install --user pytest",
  "workspaceFolder": "/workspaces/${localWorkspaceFolderBasename}/code/quantization/fixed_point",
  "customizations": {
    "codespaces": {
      "openFiles": ["fixed_point.py"]
    },
    "vscode": {
      "extensions": ["ms-python.python"],
      "settings": {
        "python.testing.pytestEnabled": true
      }
    }
  }
}
